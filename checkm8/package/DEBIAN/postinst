#!/bin/sh
set -e

# Two flavors of this package exist:
#   iphoneos-arm64 (rootless, Procursus): payload is /var/jb/usr/lib/TweakInject/*
#   iphoneos-arm   (rootful, checkra1n 12-14): payload is /usr/lib/myjb_loader.dylib
# On rootful we must NEVER create /var/jb: anti-JB SDKs (MB Bank) abort on
# that path alone (verified on 13.5.1) even with nothing inside.
ARCH="$(dpkg --print-architecture 2>/dev/null || echo unknown)"
case "$ARCH" in
    iphoneos-arm64*) ROOTLESS=1 ;;
    *) ROOTLESS=0 ;;
esac

mkdir -p "/var/mobile/Library/MyJB/containers" "/var/mobile/Library/MyJB/run"
chmod 1777 "/var/mobile/Library/MyJB/run"
chown mobile:mobile "/var/mobile/Library/MyJB" "/var/mobile/Library/MyJB/containers" "/var/mobile/Library/MyJB/run" 2>/dev/null || true

if [ ! -f "/var/mobile/Library/MyJB/kdev" ]; then
    head -c 32 /dev/urandom > "/var/mobile/Library/MyJB/kdev"
    chmod 600 "/var/mobile/Library/MyJB/kdev"
    chown mobile:mobile "/var/mobile/Library/MyJB/kdev" 2>/dev/null || true
fi

if command -v xxd >/dev/null 2>&1; then
    xxd -p -c 32 "/var/mobile/Library/MyJB/kdev" > "/var/mobile/Library/MyJB/kdev.txt"
else
    hexdump -ve '32/1 "%02x"' "/var/mobile/Library/MyJB/kdev" > "/var/mobile/Library/MyJB/kdev.txt"
    echo >> "/var/mobile/Library/MyJB/kdev.txt"
fi
chmod 644 "/var/mobile/Library/MyJB/kdev.txt"

write_rootful_plist() {
    cat > "$1" <<'PLIST_EOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Filter</key>
	<dict>
		<key>Bundles</key>
		<array>
			<string>com.apple.springboard</string>
			<string>com.apple.Security</string>
			<string>com.apple.UIKit</string>
			<string>com.apple.Foundation</string>
		</array>
	</dict>
</dict>
</plist>
PLIST_EOF
}

mirror_into() {
    SRC="$1"
    DIR="$2"
    LABEL="$3"
    cp -f "$SRC" "$DIR/myjb_loader.dylib"
    write_rootful_plist "$DIR/myjb_loader.plist"
    chmod 755 "$DIR/myjb_loader.dylib"
    chmod 644 "$DIR/myjb_loader.plist"
    echo "[myjb] loader mirrored into $DIR ($LABEL)"
}

if [ "$ROOTLESS" = "1" ]; then
    mkdir -p "/var/jb/usr/lib/myjb/containers" "/var/jb/usr/lib/myjb/run"
    chmod 1777 "/var/jb/usr/lib/myjb/run"
    echo "[myjb] rootless install: ElleKit reads /var/jb/usr/lib/TweakInject"
else
    # Remove leftovers of earlier rootful builds that wrongly created /var/jb
    # (loader payload + postinst dirs). rmdir only drops empty dirs, so a real
    # rootless bootstrap can never be touched by this branch.
    rm -f "/var/jb/usr/lib/TweakInject/myjb_loader.dylib" "/var/jb/usr/lib/TweakInject/myjb_loader.plist"
    rmdir "/var/jb/usr/lib/myjb/run" "/var/jb/usr/lib/myjb/containers" 2>/dev/null || true
    rmdir "/var/jb/usr/lib/myjb" "/var/jb/usr/lib/TweakInject" "/var/jb/usr/lib" "/var/jb/usr" "/var/jb" 2>/dev/null || true

    # Mirror only when an injection engine is actually installed; otherwise
    # remove stale loader copies (MB Bank scans these directories even after
    # Substrate was removed).
    if [ -f "/Library/MobileSubstrate/MobileSubstrate.dylib" ] && [ -d "/Library/MobileSubstrate/DynamicLibraries" ]; then
        mirror_into "/usr/lib/myjb_loader.dylib" "/Library/MobileSubstrate/DynamicLibraries" "Cydia Substrate"
    else
        rm -f "/Library/MobileSubstrate/DynamicLibraries/myjb_loader.dylib" \
              "/Library/MobileSubstrate/DynamicLibraries/myjb_loader.plist"
    fi
    if { [ -f "/usr/lib/libhooker.dylib" ] || [ -f "/usr/lib/libellekit.dylib" ]; } && [ -d "/usr/lib/TweakInject" ]; then
        mirror_into "/usr/lib/myjb_loader.dylib" "/usr/lib/TweakInject" "libhooker/ElleKit"
    else
        rm -f "/usr/lib/TweakInject/myjb_loader.dylib" \
              "/usr/lib/TweakInject/myjb_loader.plist"
    fi
    echo "[myjb] rootful install: loader at /usr/lib/myjb_loader.dylib (no /var/jb)"
fi

echo "[myjb] install ok; kdev hex: cat /var/mobile/Library/MyJB/kdev.txt"
echo "[myjb] copy that hex to the PC (--kdev-hex), then delete kdev.txt"
echo "[myjb] respring (sbreload or killall SpringBoard) to activate"
exit 0
