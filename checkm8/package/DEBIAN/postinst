#!/bin/sh
set -e

mkdir -p "/var/jb/usr/lib/myjb/containers" "/var/jb/usr/lib/myjb/run"
mkdir -p "/var/mobile/Library/MyJB/containers" "/var/mobile/Library/MyJB/run"

chmod 1777 "/var/jb/usr/lib/myjb/run" "/var/mobile/Library/MyJB/run"
chown mobile:mobile "/var/mobile/Library/MyJB" "/var/mobile/Library/MyJB/containers" "/var/mobile/Library/MyJB/run" 2>/dev/null || true

if [ ! -f "/var/mobile/Library/MyJB/kdev" ]; then
    head -c 32 /dev/urandom > "/var/mobile/Library/MyJB/kdev"
    chmod 600 "/var/mobile/Library/MyJB/kdev"
    chown mobile:mobile "/var/mobile/Library/MyJB/kdev" 2>/dev/null || true
fi

if command -v xxd >/dev/null 2>&1; then
    xxd -p -c 32 "/var/mobile/Library/MyJB/kdev" > "/var/mobile/Library/MyJB/kdev.txt"
else
    hexdump -ve '32/1 "%02x"' "/var/mobile/Library/MyJB/kdev" > "/var/mobile/Library/MyJB/kdev.txt"
    echo >> "/var/mobile/Library/MyJB/kdev.txt"
fi
chmod 644 "/var/mobile/Library/MyJB/kdev.txt"

# Rootful bootstraps (checkra1n 12-14) do not read /var/jb: mirror the loader
# into every injection directory that exists on this device. Classic Cydia
# Substrate (iOS 9+) does NOT treat an empty Filter as "all processes", so the
# rootful copies get an explicit Bundles filter (verified on 13.5.1: the empty
# packaged plist only works with ElleKit/libhooker).
SRC_DYLIB="/var/jb/usr/lib/TweakInject/myjb_loader.dylib"

write_rootful_plist() {
    cat > "$1" <<'PLIST_EOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Filter</key>
	<dict>
		<key>Bundles</key>
		<array>
			<string>com.apple.springboard</string>
			<string>com.apple.Security</string>
			<string>com.apple.UIKit</string>
			<string>com.apple.Foundation</string>
		</array>
	</dict>
</dict>
</plist>
PLIST_EOF
}

for d in "/Library/MobileSubstrate/DynamicLibraries" "/usr/lib/TweakInject"; do
    if [ -d "$d" ]; then
        cp -f "$SRC_DYLIB" "$d/"
        write_rootful_plist "$d/myjb_loader.plist"
        chmod 755 "$d/myjb_loader.dylib"
        chmod 644 "$d/myjb_loader.plist"
        echo "[myjb] loader installed into $d (rootful)"
    fi
done

echo "[myjb] install ok; kdev hex: cat /var/mobile/Library/MyJB/kdev.txt"
echo "[myjb] copy that hex to the PC (--kdev-hex), then delete kdev.txt"
echo "[myjb] respring (sbreload or killall SpringBoard) to activate"
exit 0
